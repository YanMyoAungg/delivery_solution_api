PORT=3000
NODE_ENV=development

DATABASE_URL=postgres://delivery_user:delivery_pass@localhost:5432/delivery_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=delivery_db
DB_USER=delivery_user
DB_PASSWORD=delivery_pass

JWT_SECRET=change-me-in-production
# Token expiry: must use ms() format ('1h', '30m', '7d'). Do NOT use bare numbers (3600 = 3.6 seconds, not 1 hour).
JWT_EXPIRES_IN=1h

REDIS_HOST=localhost
REDIS_PORT=6379

VIBER_BOT_TOKEN=
VIBER_GROUP_ID=
VIBER_WEBHOOK_URL=

SEED_OWNER_NAME=System Owner
SEED_OWNER_EMAIL=owner@mail.com
SEED_OWNER_PASSWORD=owner1234

# Comma-separated allowed origins. 'http://localhost:3000' for local dev; set to your frontend URL in production. Avoid '*' + credentials.
CORS_ORIGIN=http://localhost:3000
